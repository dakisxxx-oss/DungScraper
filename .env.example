# Server
DUNGSCRAPER_HOST=0.0.0.0
DUNGSCRAPER_PORT=8741
# Comma-separated. Leave empty to disable auth on localhost.
DUNGSCRAPER_API_KEYS=dungscraper-dev-key
# SDK / CLI / MCP client use the singular name.
DUNGSCRAPER_API_KEY=dungscraper-dev-key
DUNGSCRAPER_BASE_URL=http://127.0.0.1:8741

# Queue and cache. Leave empty to keep crawls inside the API process.
DUNGSCRAPER_REDIS_URL=redis://localhost:6379/0
DUNGSCRAPER_CRAWL_MODE=auto
DUNGSCRAPER_CACHE_ENABLED=true
DUNGSCRAPER_CACHE_TTL_SECONDS=3600

# Fetching
DUNGSCRAPER_RESPECT_ROBOTS_DEFAULT=true
DUNGSCRAPER_ALLOW_PRIVATE_NETWORKS=false
DUNGSCRAPER_REQUEST_TIMEOUT_SECONDS=30
DUNGSCRAPER_BROWSER_TIMEOUT_SECONDS=45
# One proxy, or a comma-separated rotation list.
# DUNGSCRAPER_PROXY_URL=http://user:pass@proxy:8080
# DUNGSCRAPER_PROXY_URLS=http://proxy-a:8080,http://proxy-b:8080

# Search providers. DuckDuckGo is used when the others are unset.
# DUNGSCRAPER_SEARXNG_URL=http://searxng:8080
# DUNGSCRAPER_BRAVE_API_KEY=
# DUNGSCRAPER_SERPER_API_KEY=

# Extraction. Any OpenAI-compatible server, including Ollama.
DUNGSCRAPER_LLM_BASE_URL=https://api.openai.com/v1
DUNGSCRAPER_LLM_API_KEY=
DUNGSCRAPER_LLM_MODEL=gpt-4o-mini

DUNGSCRAPER_LOG_LEVEL=INFO
DUNGSCRAPER_LOG_JSON=true
