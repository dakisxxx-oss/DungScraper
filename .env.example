# Copy to .env and edit. docker compose reads it automatically.

# Required. One or more API keys, comma separated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DUNGSCRAPER_API_KEYS=

# Listen on all interfaces instead of this machine only (put TLS in front of it first).
# DUNGSCRAPER_BIND=0.0.0.0

# Optional limits per API key. 0 means unlimited. Counters are in memory and reset on restart.
# DUNGSCRAPER_RATE_LIMIT_PER_MINUTE=60
# DUNGSCRAPER_RATE_LIMIT_PER_DAY=5000
# A key can have its own per-minute limit: key=limit,key=limit
# DUNGSCRAPER_KEY_LIMITS=

# Bring your own proxies. Comma or newline separated, http(s) or socks5. No proxy service is bundled.
# DUNGSCRAPER_PROXIES=http://user:pass@proxy1:8080,socks5://proxy2:1080

# Optional search and model keys.
# DUNGSCRAPER_BRAVE_API_KEY=
# DUNGSCRAPER_SEARXNG_URL=
# DUNGSCRAPER_LLM_API_KEY=

# Free public demo: allow requests with no key, limited per IP. A configured key stays unlimited
# (unless RATE_LIMIT_* is also set). Private/internal URLs stay blocked.
# DUNGSCRAPER_ALLOW_ANONYMOUS=true
# DUNGSCRAPER_ANON_RATE_LIMIT_PER_MINUTE=10
# DUNGSCRAPER_ANON_RATE_LIMIT_PER_DAY=200
# DUNGSCRAPER_ANON_MAX_PAGES=5
# DUNGSCRAPER_ANON_TIMEOUT_SECONDS=30
